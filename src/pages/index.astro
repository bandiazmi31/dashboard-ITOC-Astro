---
import Layout from '../layouts/Layout.astro';
import KPICard from '../components/KPICard.astro';
import KPICardISP from '../components/KPICardISP.astro';
import TicketsWidget from '../components/TicketsWidget.astro';
import Chart from '../components/Chart.astro';
import SensorHoneycomb from '../components/SensorHoneycomb.astro';
import DataError from '../components/DataError.astro';
import { jakartaDate, jakartaDaysAgo } from '../lib/dates';
import { createSupabaseServerClient } from '../lib/supabase';
import { getIspAvailability, type IspAvailabilityDaily } from '../lib/services/prtg-availability';
import { getSocAggregates } from '../lib/services/soc-reports';
import { buildSocDashboard, type SocDashboard } from '../lib/services/soc-kpis';

// Default date range: last 7 days, in WIB (Asia/Jakarta)
const from = jakartaDaysAgo(7);
const to = jakartaDate();

// Verify authenticated user
const supabase = createSupabaseServerClient(Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect('/login');
}

let socResult: SocDashboard | null = null;
let loadError: string | null = null;

try {
  const aggregates = await getSocAggregates(supabase, { from, to });
  socResult = buildSocDashboard(aggregates, from, to);
} catch (err) {
  console.error('[INDEX] Failed to fetch SOC data:', err instanceof Error ? err.message : err);
  loadError = 'Gagal memuat data';
}

// PRTG is reachable only from the office network, so its failure must not hide the SOC cards
let nocResult: IspAvailabilityDaily | null = null;
let nocError: string | null = null;

try {
  nocResult = await getIspAvailability(from, to);
} catch (err) {
  console.error('[INDEX] Failed to fetch PRTG availability:', err instanceof Error ? err.message : err);
  nocError = 'Gagal memuat ketersediaan dari PRTG';
}

const soc = socResult;
const noc = nocResult;

// Axis starts just below the lowest value, so the 99 % range is readable and an outage still shows
const nocValues = noc
  ? [...noc.astinet, ...noc.jlm, ...noc.lintasarta].filter((v): v is number => v !== null)
  : [];
const nocYMin = nocValues.length > 0 ? Math.max(0, Math.floor(Math.min(...nocValues)) - 1) : undefined;

// One honeycomb cell per sensor, using its most recent day in the range.
// Key on name and device: two PRTG sensors share the name "JKT - ASTINET" at different devices.
const latestPerSensor = new Map<string, NonNullable<typeof noc>['devices'][number]>();
for (const d of noc?.devices ?? []) {
  const key = `${d.sensor}|${d.device}`;
  const prev = latestPerSensor.get(key);
  if (!prev || d.date > prev.date) latestPerSensor.set(key, d);
}
const honeycombSensors = [...latestPerSensor.values()].map(d => ({
  sensorName: d.sensor,
  location: d.device,
  availability: d.availability,
  date: d.date,
}));

// Indonesian thousands separator, e.g. 12.345
const formatCount = (n: number) => n.toLocaleString('id-ID');
---

<Layout>
  <div class="bento">
    <!-- Tickets Widget (Real-time from ManageEngine) -->
    <div class="md:col-span-2 lg:col-span-6">
      <TicketsWidget />
    </div>

    {loadError && <div class="md:col-span-2 lg:col-span-6"><DataError message={loadError} /></div>}

    {soc && (
      <>
        <!-- SOC KPI Cards -->
        <div class="lg:col-span-2">
          <KPICard
            label="Total Kejadian Ancaman"
            value={formatCount(soc.kpi.totalThreats)}
            status="info"
          />
        </div>
        <div class="lg:col-span-2">
          <KPICard
            label="High/Critical Threats"
            value={formatCount(soc.kpi.highCriticalThreats)}
            unit={`(${soc.kpi.highCriticalPercentage}%)`}
            status={soc.kpi.highCriticalPercentage > 5 ? 'warning' : 'safe'}
          />
        </div>
        <div class="lg:col-span-2">
          <KPICard
            label="Ancaman Diblokir"
            value={`${soc.kpi.blockedPercentage}%`}
            unit={`(${formatCount(soc.kpi.blockedThreats)} kejadian)`}
            status="safe"
          />
        </div>
        <div class="lg:col-span-3">
          <KPICard
            label="Host Internal Terimbas"
            value={formatCount(soc.kpi.internalHostCount)}
            unit="host"
            status="info"
          />
        </div>
        <div class="lg:col-span-3">
          <KPICard
            label="Trafik Aplikasi"
            value={soc.kpi.applicationVolume}
            status="info"
          />
        </div>

        <!-- NOC KPI Cards - ISP Availability -->
        {noc?.kpi.ispAvailability.map(isp => (
          <div class="lg:col-span-2">
            <KPICardISP
              ispName={isp.name}
              actual={isp.actual}
              sla={isp.sla}
              status={isp.status}
            />
          </div>
        ))}

        <!-- Trend Charts (SOC & NOC) -->
        <div class="md:col-span-2 lg:col-span-3">
          <Chart
            id="socTrendChart"
            type="line"
            title="Kejadian Ancaman per Hari"
            labels={soc.dates}
            datasets={[
              {
                label: 'Semua Ancaman',
                data: soc.threats_all,
                borderColor: '#6366f1',
                tension: 0.4,
                fill: false
              },
              {
                label: 'High/Critical',
                data: soc.threats_high_critical,
                borderColor: '#ef4444',
                tension: 0.4,
                fill: false
              }
            ]}
          />
        </div>
        {noc && (
        <div class="md:col-span-2 lg:col-span-3">
          <Chart
            id="nocTrendChart"
            type="line"
            title="Ketersediaan ISP per Hari"
            yMin={nocYMin}
            labels={noc.dates}
            datasets={[
              {
                label: 'Astinet',
                data: noc.astinet,
                borderColor: '#3b82f6',
                tension: 0.4,
                fill: false
              },
              {
                label: 'JLM',
                data: noc.jlm,
                borderColor: '#f59e0b',
                tension: 0.4,
                fill: false
              },
              {
                label: 'Lintasarta',
                data: noc.lintasarta,
                borderColor: '#10b981',
                tension: 0.4,
                fill: false
              }
            ]}
          />
        </div>
        )}

        <!-- Sensor honeycomb: one cell per sensor (same source as the NOC page) -->
        {noc && (
        <div class="md:col-span-2 lg:col-span-6">
          <SensorHoneycomb
            title="Status Kesehatan Sensor"
            sensors={honeycombSensors}
          />
        </div>
        )}
      </>
    )}
  </div>
</Layout>
