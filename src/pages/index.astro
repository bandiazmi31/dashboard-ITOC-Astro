---
import Layout from '../layouts/Layout.astro';
import KPICard from '../components/KPICard.astro';
import KPICardISP from '../components/KPICardISP.astro';
import TicketsWidget from '../components/TicketsWidget.astro';
import Chart from '../components/Chart.astro';
import SensorHoneycomb from '../components/SensorHoneycomb.astro';
import DataError from '../components/DataError.astro';
import { jakartaDate, jakartaDaysAgo } from '../lib/dates';
import { createSupabaseServerClient } from '../lib/supabase';
import { getNocTrends, type NocTrendsResult } from '../lib/services/analytics';
import { getSocAggregates } from '../lib/services/soc-reports';
import { buildSocDashboard, type SocDashboard } from '../lib/services/soc-kpis';

// Default date range: last 7 days, in WIB (Asia/Jakarta)
const from = jakartaDaysAgo(7);
const to = jakartaDate();

// Verify authenticated user
const supabase = createSupabaseServerClient(Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect('/login');
}

let socResult: SocDashboard | null = null;
let nocResult: NocTrendsResult | null = null;
let loadError: string | null = null;

try {
  const [aggregates, noc] = await Promise.all([
    getSocAggregates(supabase, { from, to }),
    getNocTrends(supabase, { from, to })
  ]);
  socResult = buildSocDashboard(aggregates, from, to);
  nocResult = noc;
} catch (err) {
  console.error('[INDEX] Failed to fetch dashboard data:', err instanceof Error ? err.message : err);
  loadError = 'Gagal memuat data';
}

const soc = socResult;
const noc = nocResult;
---

<Layout>
  <div class="bento">
    <!-- Tickets Widget (Real-time from ManageEngine) -->
    <div class="md:col-span-2 lg:col-span-6">
      <TicketsWidget />
    </div>

    {loadError && <div class="md:col-span-2 lg:col-span-6"><DataError message={loadError} /></div>}

    {soc && noc && (
      <>
        <!-- SOC KPI Cards -->
        <div class="lg:col-span-2">
          <KPICard
            label="Total Kejadian Ancaman"
            value={soc.kpi.totalThreats}
            status="info"
          />
        </div>
        <div class="lg:col-span-2">
          <KPICard
            label="High/Critical Threats"
            value={soc.kpi.highCriticalThreats}
            unit={`(${soc.kpi.highCriticalPercentage}%)`}
            status={soc.kpi.highCriticalPercentage > 5 ? 'warning' : 'safe'}
          />
        </div>
        <div class="lg:col-span-2">
          <KPICard
            label="Ancaman Diblokir"
            value={`${soc.kpi.blockedPercentage}%`}
            unit={`(${soc.kpi.blockedThreats} kejadian)`}
            status="safe"
          />
        </div>
        <div class="lg:col-span-3">
          <KPICard
            label="Host Internal Terimbas"
            value={soc.kpi.internalHostCount}
            unit="host"
            status="info"
          />
        </div>
        <div class="lg:col-span-3">
          <KPICard
            label="Trafik Aplikasi"
            value={soc.kpi.applicationVolume}
            status="info"
          />
        </div>

        <!-- NOC KPI Cards - ISP Availability -->
        {noc.kpi.ispAvailability.map(isp => (
          <div class="lg:col-span-2">
            <KPICardISP
              ispName={isp.name}
              actual={isp.actual}
              sla={isp.sla}
              status={isp.status}
            />
          </div>
        ))}

        <!-- Trend Charts (SOC & NOC) -->
        <div class="md:col-span-2 lg:col-span-3">
          <Chart
            id="socTrendChart"
            type="line"
            title="Kejadian Ancaman per Hari"
            labels={soc.dates}
            datasets={[
              {
                label: 'Semua Ancaman',
                data: soc.threats_all,
                borderColor: '#6366f1',
                tension: 0.4,
                fill: false
              },
              {
                label: 'High/Critical',
                data: soc.threats_high_critical,
                borderColor: '#ef4444',
                tension: 0.4,
                fill: false
              }
            ]}
          />
        </div>
        <div class="md:col-span-2 lg:col-span-3">
          <Chart
            id="nocTrendChart"
            type="line"
            title="Ketersediaan ISP per Hari"
            labels={noc.dates}
            datasets={[
              {
                label: 'Astinet',
                data: noc.astinet,
                borderColor: '#3b82f6',
                tension: 0.4,
                fill: false
              },
              {
                label: 'JLM',
                data: noc.jlm,
                borderColor: '#f59e0b',
                tension: 0.4,
                fill: false
              },
              {
                label: 'Lintasarta',
                data: noc.lintasarta,
                borderColor: '#10b981',
                tension: 0.4,
                fill: false
              }
            ]}
          />
        </div>

        <!-- Sensor honeycomb (same source as the NOC page) -->
        <div class="md:col-span-2 lg:col-span-6">
          <SensorHoneycomb
            title="Status Kesehatan Sensor"
            sensors={noc.devices.map(d => ({
              sensorName: d.sensor,
              location: d.device,
              availability: d.availability,
              date: d.date,
            }))}
          />
        </div>
      </>
    )}
  </div>
</Layout>
