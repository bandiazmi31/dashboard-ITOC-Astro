---
import Layout from '../layouts/Layout.astro';
import HandoverWidget from '../components/HandoverWidget.astro';
---

<Layout>
  <div class="space-y-6">
    <!-- Page Title -->
    <div>
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Admin</h2>
      <p class="text-sm text-gray-600 dark:text-gray-300 mt-1">Panel pengaturan sistem dan serah terima.</p>
    </div>

    <!-- Handover Widget (live: backed by the handovers API) -->
    <HandoverWidget />

    <!-- Settings placeholder: the earlier settings controls were not wired to anything -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow dark:shadow-gray-900 p-10 flex flex-col items-center justify-center text-center">
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Pengaturan admin sedang dalam pengembangan</h3>
      <p class="mt-2 max-w-md text-sm text-gray-500 dark:text-gray-400">
        Pengaturan ambang batas dan sinkronisasi akan tersedia pada rilis berikutnya.
      </p>
    </div>
  </div>
</Layout>
