---
import Layout from '../layouts/Layout.astro';
import KPICard from '../components/KPICard.astro';
import Chart from '../components/Chart.astro';
import TopNTable from '../components/TopNTable.astro';
import DateFilter from '../components/DateFilter.astro';
import DataError from '../components/DataError.astro';
import { createSupabaseServerClient } from '../lib/supabase';
import {
  getSocAggregates,
  getSocReportRows,
  REPORT_TYPES,
  type SocAggregates,
  type SocReportRow,
} from '../lib/services/soc-reports';
import { buildSocDashboard, type SocDashboard } from '../lib/services/soc-kpis';
import {
  severityTable,
  threatNameTable,
  urlCategoryTable,
  internalHostTable,
  topSourceTable,
  applicationTable,
  genericTop10,
} from '../lib/services/soc-tables';
import { jakartaDate, jakartaDaysAgo } from '../lib/dates';

// Get query params for date range, or default to last 7 days (WIB)
const url = new URL(Astro.request.url);
const from = url.searchParams.get('from') || jakartaDaysAgo(7);
const to = url.searchParams.get('to') || jakartaDate();

// Verify authenticated user
const supabase = createSupabaseServerClient(Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect('/login');
}

const GENERIC_TYPES = [REPORT_TYPES.ruleZone, REPORT_TYPES.trafficTop, REPORT_TYPES.trafficDenied];

const [aggregatesOutcome, genericOutcome] = await Promise.allSettled([
  getSocAggregates(supabase, { from, to }),
  getSocReportRows(supabase, { from, to }, GENERIC_TYPES),
]);

let aggregates: SocAggregates | null = null;
let genericRows: SocReportRow[] = [];
let reportsError: string | null = null;
if (aggregatesOutcome.status === 'fulfilled' && genericOutcome.status === 'fulfilled') {
  aggregates = aggregatesOutcome.value;
  genericRows = genericOutcome.value;
} else {
  const reason = aggregatesOutcome.status === 'rejected' ? aggregatesOutcome.reason : genericOutcome.status === 'rejected' ? genericOutcome.reason : null;
  console.error('[SOC] Failed to fetch SOC reports:', reason);
  reportsError = 'Gagal memuat laporan SOC';
}

const soc: SocDashboard | null = aggregates ? buildSocDashboard(aggregates, from, to) : null;

const severity = aggregates ? severityTable(aggregates.severity) : [];
const threatNames = aggregates ? threatNameTable(aggregates.threatNames) : [];
const urlCategories = aggregates ? urlCategoryTable(aggregates.urlCategories) : [];
const internalHosts = aggregates ? internalHostTable(aggregates.internalHosts) : [];
const topSources = aggregates ? topSourceTable(aggregates.topSources) : [];
const applications = aggregates ? applicationTable(aggregates.applications) : [];

const rowsOf = (type: string) => genericRows.filter(r => r.laporan_type === type);
const otherReports = [
  { title: 'Traffic Rule Zone', type: REPORT_TYPES.ruleZone },
  { title: 'Traffic Teratas', type: REPORT_TYPES.trafficTop },
  { title: 'Traffic Ditolak', type: REPORT_TYPES.trafficDenied },
].map(r => ({ title: r.title, ...genericTop10(rowsOf(r.type)) }));

const hasAnyReports =
  !reportsError &&
  (genericRows.length > 0 ||
    (aggregates !== null &&
      (aggregates.severity.length + aggregates.threatNames.length + aggregates.urlCategories.length +
        aggregates.internalHosts.length + aggregates.topSources.length + aggregates.applications.length) > 0));
---

<Layout>
  <div class="space-y-6">
    <DateFilter
      from={from}
      to={to}
    />

    {reportsError && <DataError message={reportsError} />}

    {soc && (
      <>
        <!-- KPI Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <KPICard
            label="Total Kejadian Ancaman"
            value={soc.kpi.totalThreats}
            status="info"
          />
          <KPICard
            label="High/Critical Threats"
            value={soc.kpi.highCriticalThreats}
            unit={`(${soc.kpi.highCriticalPercentage}%)`}
            status={soc.kpi.highCriticalPercentage > 5 ? 'warning' : 'safe'}
          />
          <KPICard
            label="Ancaman Diblokir"
            value={`${soc.kpi.blockedPercentage}%`}
            unit={`(${soc.kpi.blockedThreats} kejadian)`}
            status="safe"
          />
          <KPICard
            label="Host Internal Terimbas"
            value={soc.kpi.internalHostCount}
            unit="host"
            status="info"
          />
          <KPICard
            label="Trafik Aplikasi"
            value={soc.kpi.applicationVolume}
            status="info"
          />
          <KPICard
            label="Total Akses URL"
            value={soc.kpi.urlAccesses}
            unit="akses"
            status="info"
          />
        </div>

        <!-- Trend Charts (2 columns) -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <Chart
            id="socThreatTrendChart"
            type="line"
            title="Kejadian Ancaman per Hari"
            labels={soc.dates}
            datasets={[
              {
                label: 'Semua Ancaman',
                data: soc.threats_all,
                borderColor: '#6366f1',
                tension: 0.4,
                fill: false
              },
              {
                label: 'High/Critical',
                data: soc.threats_high_critical,
                borderColor: '#ef4444',
                tension: 0.4,
                fill: false
              }
            ]}
          />

          <Chart
            id="socTrafficTrendChart"
            type="line"
            title="Grafik Trafik Harian"
            labels={soc.dates}
            valueFormat="bytes"
            datasets={[
              {
                label: 'Trafik',
                data: soc.traffic_bytes,
                borderColor: '#10b981',
                tension: 0.4,
                fill: false
              }
            ]}
          />
        </div>
      </>
    )}

    {!reportsError && !hasAnyReports && (
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow dark:shadow-gray-900 p-10 flex flex-col items-center justify-center text-center">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Data analitik belum tersedia</h3>
        <p class="mt-2 max-w-md text-sm text-gray-500 dark:text-gray-400">
          Unggah laporan SOC (.xlsx) di atas, atau pilih rentang tanggal lain, untuk menampilkan rincian analitik.
        </p>
      </div>
    )}

    {!reportsError && hasAnyReports && (
      <>
        <!-- Six analytics tables -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <TopNTable
            title="Menurut Severity"
            columns={['Severity', 'Jumlah', 'Persentase']}
            data={severity}
            barColumn="percentage"
            colorMapping="severity"
            limit={10}
          />

          <TopNTable
            title="Nama Ancaman High/Critical Teratas"
            columns={['Nama Ancaman', 'Kejadian', '%']}
            data={threatNames}
            barColumn="percentage"
            limit={10}
          />

          <TopNTable
            title="Kategori URL Ancaman Teratas"
            columns={['Kategori', 'Kejadian', '%']}
            data={urlCategories}
            barColumn="percentage"
            limit={10}
          />

          <TopNTable
            title="Host Internal dengan Ancaman Terbanyak"
            columns={['IP Address', 'Kejadian', '%']}
            data={internalHosts}
            barColumn="percentage"
            limit={10}
          />

          <TopNTable
            title="Sumber High/Critical Teratas"
            columns={['IP Address', 'Negara', 'Kejadian', '%']}
            data={topSources}
            barColumn="percentage"
            limit={10}
          />

          <TopNTable
            title="Aplikasi dengan Trafik Terbesar"
            columns={['Aplikasi', 'Volume', '%']}
            data={applications}
            barColumn="percentage"
            limit={10}
          />
        </div>

        <!-- Other report types: generic top-10 view so the data is visible -->
        <section class="space-y-6">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Laporan Lainnya</h3>

          {otherReports.map(report => (
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow dark:shadow-gray-900 p-3 sm:p-4 overflow-x-auto">
              <h4 class="text-sm sm:text-base font-semibold text-gray-900 dark:text-white mb-3">{report.title}</h4>
              {report.rows.length === 0 ? (
                <p class="py-6 text-center text-sm text-gray-500 dark:text-gray-400">Tidak ada data tersedia</p>
              ) : (
                <table class="w-full text-left border-collapse">
                  <thead>
                    <tr class="border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900">
                      {report.keys.map(k => (
                        <th class="px-3 py-2 text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider">{k.toUpperCase()}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                    {report.rows.map(row => (
                      <tr>
                        {report.keys.map(k => (
                          <td class="px-3 py-2 text-xs text-gray-800 dark:text-gray-300 whitespace-nowrap">{row[k] ?? ''}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              )}
            </div>
          ))}
        </section>
      </>
    )}
  </div>
</Layout>
