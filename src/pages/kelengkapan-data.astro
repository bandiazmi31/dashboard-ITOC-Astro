---
import Layout from '../layouts/Layout.astro';
import PRTGUploadWidget from '../components/PRTGUploadWidget.astro';
import SOCUploadWidget from '../components/SOCUploadWidget.astro';
import { jakartaDate } from '../lib/dates';
---

<Layout>
  <div class="space-y-6">
    <!-- Page Title & Description -->
    <div>
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Kelengkapan Data</h2>
      <p class="text-sm text-gray-600 dark:text-gray-300 mt-1">
        Halaman ini menampilkan status kelengkapan data harian dari sistem monitoring (Palo Alto, PRTG).
        Data ini menentukan akurasi dashboard.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
      <PRTGUploadWidget />
      <SOCUploadWidget defaultDate={jakartaDate()} />
    </div>

    <!-- Completeness status: no live source exists yet -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow dark:shadow-gray-900 p-10 flex flex-col items-center justify-center text-center">
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Data belum tersedia</h3>
      <p class="mt-2 max-w-md text-sm text-gray-500 dark:text-gray-400">
        Status kelengkapan harian laporan SOC, PDF PRTG, dan cakupan sensor akan ditampilkan setelah sumber datanya tersedia.
      </p>
    </div>
  </div>
</Layout>
