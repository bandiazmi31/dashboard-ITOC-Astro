---
import Layout from '../layouts/Layout.astro';
import Chart from '../components/Chart.astro';
import DataError from '../components/DataError.astro';
import { createSupabaseServerClient } from '../lib/supabase';
import { getSensorSeries, getTrafficPage, parseRange, TRAFFIC_RANGES, type TrafficPageData, type TrafficSeries } from '../lib/services/traffic';
import TrafficKpis from '../components/TrafficKpis.astro';
import TrafficSensorDetail from '../components/TrafficSensorDetail.astro';

const url = new URL(Astro.request.url);

// Verify authenticated user
const supabase = createSupabaseServerClient(Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect('/login');
}

// Traffic PRTG section: hourly In/Out, 24 h or 7 d. Loads on its own, so a failure here leaves the rest of the page up.
const trafficRange = parseRange(url.searchParams.get('range'));
let traffic: TrafficPageData | null = null;
let trafficSeries: TrafficSeries | null = null;
let trafficSelected: number | null = null;
let trafficError: string | null = null;

try {
  traffic = await getTrafficPage(supabase, trafficRange);
  const requested = Number(url.searchParams.get('sensor'));
  const known = traffic.sensors.some(s => s.sensor_id === requested);
  trafficSelected = known ? requested : (traffic.top[0]?.sensor_id ?? traffic.sensors[0]?.sensor_id ?? null);
  if (trafficSelected !== null) {
    trafficSeries = await getSensorSeries(supabase, trafficSelected, trafficRange);
  }
} catch (err) {
  console.error('[NOC] Failed to load traffic:', err instanceof Error ? err.message : err);
  trafficError = 'Gagal memuat data trafik PRTG';
}

const syncTime = traffic?.sync.finishedAt
  ? new Intl.DateTimeFormat('id-ID', { timeZone: 'Asia/Jakarta', dateStyle: 'medium', timeStyle: 'short' }).format(new Date(traffic.sync.finishedAt))
  : null;
const trafficRangeLabel: Record<string, string> = { '24h': '24 jam', '7d': '7 hari' };
---

<Layout>
  <div class="bento">
    <!-- Traffic PRTG: hourly In and Out per sensor -->
    <section class="md:col-span-2 lg:col-span-6 space-y-4" aria-labelledby="trafficHeading">
      <div class="flex flex-col sm:flex-row sm:items-center gap-3">
        <div class="flex-1">
          <h2 id="trafficHeading" class="text-xl font-semibold text-gray-900 dark:text-white">Trafik PRTG</h2>
          {traffic && (
            <p class="text-sm text-gray-600 dark:text-gray-400">
              Rata-rata per jam, {trafficRangeLabel[trafficRange]} terakhir (WIB)
              {syncTime && <> · Sinkron terakhir: {syncTime}</>}
              {traffic.sync.status === 'partial' && <span class="text-amber-700 dark:text-amber-300"> · Sinkron sebagian ({traffic.sync.errorCount} masalah)</span>}
              {traffic.sync.status === 'failed' && <span class="text-red-700 dark:text-red-300"> · Sinkron terakhir gagal</span>}
              {!syncTime && <> · Belum pernah disinkron</>}
            </p>
          )}
        </div>
        <nav aria-label="Rentang waktu trafik" class="flex gap-2">
          {TRAFFIC_RANGES.map(r => (
            <a
              href={`?range=${r}${trafficSelected !== null ? `&sensor=${trafficSelected}` : ''}`}
              aria-current={r === trafficRange ? 'page' : undefined}
              class={`px-3 py-1.5 rounded-md text-sm font-medium border ${r === trafficRange ? 'bg-blue-600 text-white border-blue-600' : 'border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800'}`}
            >
              {trafficRangeLabel[r]}
            </a>
          ))}
        </nav>
      </div>

      {trafficError && <DataError message={trafficError} />}

      {traffic && (
        <>
          <TrafficKpis kpis={traffic.kpis} />

          <div class="md:col-span-2 lg:col-span-6 grid grid-cols-1 lg:grid-cols-2 gap-4">
            <Chart
              id="trafficTotalChart"
              type="line"
              title="Total Trafik In dan Out (Mbit/s)"
              labels={traffic.total.labels}
              datasets={[
                { label: 'Traffic In', data: traffic.total.in, borderColor: '#3b82f6', tension: 0.4, fill: false },
                { label: 'Traffic Out', data: traffic.total.out, borderColor: '#f59e0b', tension: 0.4, fill: false },
              ]}
            />
            <Chart
              id="trafficTopChart"
              type="bar"
              title="10 Sensor Teratas (rata-rata Mbit/s)"
              labels={traffic.top.map(t => t.name)}
              datasets={[
                { label: 'Rata-rata In', data: traffic.top.map(t => t.avgIn), backgroundColor: '#3b82f6' },
                { label: 'Rata-rata Out', data: traffic.top.map(t => t.avgOut), backgroundColor: '#f59e0b' },
              ]}
            />
          </div>

          <TrafficSensorDetail
            sensors={traffic.sensors}
            selected={trafficSelected}
            range={trafficRange}
            series={trafficSeries}
          />
        </>
      )}
    </section>
  </div>
</Layout>
