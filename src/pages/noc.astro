---
import Layout from '../layouts/Layout.astro';
import KPICardISP from '../components/KPICardISP.astro';
import Chart from '../components/Chart.astro';
import TopNTable from '../components/TopNTable.astro';
import DateFilter from '../components/DateFilter.astro';
import DataError from '../components/DataError.astro';
import { jakartaDate, jakartaDaysAgo } from '../lib/dates';
import { createSupabaseServerClient } from '../lib/supabase';
import { getNocTrends, type NocTrendsResult } from '../lib/services/analytics';

// Get query params for date range, or default to last 7 days
const url = new URL(Astro.request.url);
const from = url.searchParams.get('from') || jakartaDaysAgo(7);
const to = url.searchParams.get('to') || jakartaDate();

// Verify authenticated user
const supabase = createSupabaseServerClient(Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect('/login');
}

let nocResult: NocTrendsResult | null = null;
let loadError: string | null = null;

try {
  nocResult = await getNocTrends(supabase, { from, to });
} catch (err) {
  console.error('[NOC] Failed to fetch from Supabase:', err instanceof Error ? err.message : err);
  loadError = 'Gagal memuat data';
}

const noc = nocResult;

// Top 20 sensors by downtime (seconds), taken from the live PRTG rows
const topDowntime = noc
  ? [...noc.devices].sort((a, b) => b.downtime - a.downtime).slice(0, 20)
  : [];
---

<Layout>
  <div class="space-y-6">
    <DateFilter
      from={from}
      to={to}
    />

    {loadError && <DataError message={loadError} />}

    {noc && (
      <>
        <!-- NOC KPI Cards - ISP Availability -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {noc.kpi.ispAvailability.map(isp => (
            <KPICardISP
              ispName={isp.name}
              actual={isp.actual}
              sla={isp.sla}
              status={isp.status}
            />
          ))}
        </div>

        <!-- Trend Charts (2 columns) -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <Chart
            id="nocIspTrendChart"
            type="line"
            title="Ketersediaan ISP per Hari"
            labels={noc.dates}
            datasets={[
              {
                label: 'Astinet',
                data: noc.astinet,
                borderColor: '#3b82f6',
                tension: 0.4,
                fill: false
              },
              {
                label: 'JLM',
                data: noc.jlm,
                borderColor: '#f59e0b',
                tension: 0.4,
                fill: false
              },
              {
                label: 'Lintasarta',
                data: noc.lintasarta,
                borderColor: '#10b981',
                tension: 0.4,
                fill: false
              }
            ]}
          />

          <Chart
            id="nocTrafficTrendChart"
            type="line"
            title="Trafik Rata-rata per Hari"
            labels={noc.dates}
            datasets={[
              {
                label: 'Trafik (Mbps)',
                data: noc.traffic_mbps,
                borderColor: '#8b5cf6',
                tension: 0.4,
                fill: false
              }
            ]}
          />
        </div>

        <!-- Analytics Tables (Full-width Stacked) -->
        <div class="space-y-6">
          <TopNTable
            title="Sensor dengan Downtime (20 Terbesar)"
            columns={['Tanggal', 'Sensor', 'Lokasi', 'Downtime']}
            data={topDowntime.map(d => ({ date: d.date, sensor: d.sensor, location: d.device, downtime: `${d.downtime}s` }))}
            limit={20}
          />

          <div class="overflow-x-auto">
            <TopNTable
              title="Seluruh Sensor"
              columns={['Tanggal', 'Sensor', 'Lokasi', 'Ketersediaan %', 'Trafik (Mbps)']}
              data={noc.devices.map(d => ({ date: d.date, sensor: d.sensor, location: d.device, availability: d.availability === null ? 'N/A' : `${d.availability}%`, traffic: d.traffic }))}
              limit={50}
            />
          </div>
        </div>
      </>
    )}
  </div>
</Layout>
