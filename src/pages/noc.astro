---
import Layout from '../layouts/Layout.astro';
import KPICardISP from '../components/KPICardISP.astro';
import Chart from '../components/Chart.astro';
import TopNTable from '../components/TopNTable.astro';
import SensorHoneycomb from '../components/SensorHoneycomb.astro';
import DateFilter from '../components/DateFilter.astro';
import DataError from '../components/DataError.astro';
import { jakartaDate, jakartaDaysAgo } from '../lib/dates';
import { createSupabaseServerClient } from '../lib/supabase';
import { getNocTrends, type NocTrendsResult } from '../lib/services/analytics';

// Get query params for date range, or default to last 7 days
const url = new URL(Astro.request.url);
const from = url.searchParams.get('from') || jakartaDaysAgo(7);
const to = url.searchParams.get('to') || jakartaDate();

// Verify authenticated user
const supabase = createSupabaseServerClient(Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect('/login');
}

let nocResult: NocTrendsResult | null = null;
let loadError: string | null = null;

try {
  nocResult = await getNocTrends(supabase, { from, to });
} catch (err) {
  console.error('[NOC] Failed to fetch from Supabase:', err instanceof Error ? err.message : err);
  loadError = 'Gagal memuat data';
}

const noc = nocResult;

// Top 20 sensors by downtime (seconds), taken from the live PRTG rows
const topDowntime = noc
  ? [...noc.devices].sort((a, b) => b.downtime - a.downtime).slice(0, 20)
  : [];
---

<Layout>
  <div class="bento">
    <div class="md:col-span-2 lg:col-span-6">
      <DateFilter
        from={from}
        to={to}
      />
    </div>

    <div class="md:col-span-2 lg:col-span-6 flex items-center gap-4">
      <button
        id="prtgSyncBtn"
        type="button"
        class="px-4 py-2 bg-blue-600 text-white rounded-md text-sm font-medium hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed transition-colors whitespace-nowrap"
      >
        Sinkron dari PRTG
      </button>
      <span id="prtgSyncStatus" class="text-sm text-gray-600 dark:text-gray-400"></span>
    </div>

    {loadError && <div class="md:col-span-2 lg:col-span-6"><DataError message={loadError} /></div>}

    {noc && (
      <>
        <!-- NOC KPI Cards - ISP Availability -->
        {noc.kpi.ispAvailability.map(isp => (
          <div class="lg:col-span-2">
            <KPICardISP
              ispName={isp.name}
              actual={isp.actual}
              sla={isp.sla}
              status={isp.status}
            />
          </div>
        ))}

        <!-- Trend Charts (2 columns) -->
        <div class="md:col-span-2 lg:col-span-3">
          <Chart
            id="nocIspTrendChart"
            type="line"
            title="Ketersediaan ISP per Hari"
            labels={noc.dates}
            datasets={[
              {
                label: 'Astinet',
                data: noc.astinet,
                borderColor: '#3b82f6',
                tension: 0.4,
                fill: false
              },
              {
                label: 'JLM',
                data: noc.jlm,
                borderColor: '#f59e0b',
                tension: 0.4,
                fill: false
              },
              {
                label: 'Lintasarta',
                data: noc.lintasarta,
                borderColor: '#10b981',
                tension: 0.4,
                fill: false
              }
            ]}
          />
        </div>
        <div class="md:col-span-2 lg:col-span-3">
          <Chart
            id="nocTrafficTrendChart"
            type="line"
            title="Trafik Rata-rata per Hari"
            labels={noc.dates}
            datasets={[
              {
                label: 'Trafik (Mbps)',
                data: noc.traffic_mbps,
                borderColor: '#8b5cf6',
                tension: 0.4,
                fill: false
              }
            ]}
          />
        </div>

        <!-- Analytics Tables (Full-width Stacked) -->
        <div class="md:col-span-2 lg:col-span-6 space-y-4">
          <TopNTable
            title="Sensor dengan Downtime (20 Terbesar)"
            columns={['Tanggal', 'Sensor', 'Lokasi', 'Downtime']}
            data={topDowntime.map(d => ({ date: d.date, sensor: d.sensor, location: d.device, downtime: `${d.downtime}s` }))}
            limit={20}
          />

          <SensorHoneycomb
            title="Status Kesehatan Sensor"
            sensors={noc.devices.map(d => ({
              sensorName: d.sensor,
              location: d.device,
              availability: d.availability,
              date: d.date,
            }))}
          />
        </div>
      </>
    )}
  </div>
</Layout>

<script>
  const syncBtn = document.getElementById('prtgSyncBtn') as HTMLButtonElement | null;
  const syncStatus = document.getElementById('prtgSyncStatus');

  syncBtn?.addEventListener('click', async () => {
    if (!syncBtn) return;
    syncBtn.disabled = true;
    if (syncStatus) syncStatus.textContent = 'Menyinkronkan dari PRTG...';

    try {
      const res = await fetch('/api/noc/sync-prtg', { method: 'POST' });
      const body = await res.json();
      if (!res.ok) throw new Error(body.error || 'Sinkron PRTG gagal');

      if (syncStatus) {
        const parts = [`${body.delta} sensor dihitung`];
        if (body.no_baseline) parts.push(`${body.no_baseline} tanpa snapshot sebelumnya`);
        if (body.counter_reset) parts.push(`${body.counter_reset} counter reset`);
        syncStatus.textContent = `${parts.join(', ')} untuk ${body.import_date}`;
      }
      window.location.reload();
    } catch (err) {
      if (syncStatus) syncStatus.textContent = err instanceof Error ? err.message : 'Sinkron PRTG gagal';
      syncBtn.disabled = false;
    }
  });
</script>
