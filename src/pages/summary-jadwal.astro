---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="space-y-6" data-itoc-page>
    <header>
      <h2 class="text-lg sm:text-xl font-semibold text-gray-900 dark:text-white">Summary &amp; Jadwal ITOC</h2>
      <p class="text-xs text-gray-600 dark:text-gray-400">Sumber: Summary Data ITOC &amp; EOS.xlsx (sheet Summary dan Shift ITOC)</p>
    </header>

    <!-- Loading state -->
    <div data-state="loading" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" aria-live="polite">
      <div class="h-40 rounded-2xl bg-gray-200 dark:bg-gray-800 animate-pulse md:col-span-2 lg:col-span-3"></div>
      <div class="h-56 rounded-2xl bg-gray-200 dark:bg-gray-800 animate-pulse md:col-span-2 lg:col-span-3"></div>
      <div class="h-72 rounded-2xl bg-gray-200 dark:bg-gray-800 animate-pulse md:col-span-2 lg:col-span-3"></div>
    </div>

    <!-- Error state -->
    <div data-state="error" role="alert" class="hidden bg-red-50 dark:bg-red-900/30 border-l-4 border-red-500 p-4 rounded">
      <p class="text-sm font-semibold text-red-800 dark:text-red-200" data-error-text></p>
    </div>

    <!-- Content -->
    <div data-state="content" class="hidden bento">

      <!-- Top section: active shift beside the shift timeline on xl+, stacked below that -->
      <div class="md:col-span-2 lg:col-span-6 grid grid-cols-1 xl:grid-cols-[450px_minmax(0,1fr)] gap-6 items-stretch">
      <!-- On duty today -->
      <section class="bento-tile flex flex-col p-4 sm:p-5" aria-labelledby="duty-title">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-1">
          <div>
            <h3 id="duty-title" class="text-base font-semibold text-gray-900 dark:text-white">Sedang Bertugas</h3>
            <p class="text-xs text-gray-700 dark:text-gray-400" data-today-date></p>
          </div>
          <p class="text-sm font-semibold text-gray-900 dark:text-white tabular-nums" data-clock aria-live="off"></p>
        </div>
        <div data-duty class="mt-6 flex flex-1 items-center justify-center"></div>
      </section>

      <!-- Shift timeline: today and the next 30 days -->
      <section class="bento-tile min-w-0 p-4 sm:p-5" aria-labelledby="shift-title">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-3">
          <div>
            <h3 id="shift-title" class="text-base font-semibold text-gray-900 dark:text-white">Jadwal Shift ITOC</h3>
            <p class="text-xs text-gray-700 dark:text-gray-400">Geser horizontal untuk melihat seluruh tanggal.</p>
          </div>
          <ul data-legend class="flex flex-wrap gap-x-4 gap-y-2 text-xs text-gray-800 dark:text-gray-300"></ul>
        </div>
        <div class="mt-3 overflow-x-auto max-h-[28rem] rounded-xl border border-gray-200 dark:border-gray-700 shift-scroll" tabindex="0" role="region" aria-labelledby="shift-title">
          <table class="text-center border-separate border-spacing-0 text-xs">
            <caption class="sr-only">Jadwal shift tiap tim, mulai hari ini</caption>
            <thead data-shift-head></thead>
            <tbody data-shift-body></tbody>
          </table>
        </div>
      </section>

      </div>

      <!-- Roster: one column per team -->
      <section class="bento-tile md:col-span-2 lg:col-span-6 p-4 sm:p-5" aria-labelledby="roster-title">
        <h3 id="roster-title" class="text-base font-semibold text-gray-900 dark:text-white">Roster Personel per Tim</h3>
        <button type="button" class="accordion-toggle md:hidden mt-3 w-full flex items-center justify-between gap-2 rounded-lg border border-slate-600 bg-slate-800 px-4 py-2.5 text-sm font-medium text-white hover:bg-slate-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500" aria-expanded="false" aria-controls="roster-panel" data-accordion-name="Roster Personel">
          <span data-accordion-label>Tampilkan Roster Personel</span>
          <svg class="w-4 h-4 shrink-0 transition-transform duration-200 motion-reduce:transition-none" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"></path>
          </svg>
        </button>
        <!-- Collapsed on mobile until the toggle is pressed; always shown from md up -->
        <div id="roster-panel" class="hidden md:block mt-4">
          <div data-roster class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4"></div>
        </div>
      </section>

      <!-- Locations -->
      <section class="bento-tile md:col-span-2 lg:col-span-6 p-4 sm:p-5" aria-labelledby="lokasi-title">
        <h3 id="lokasi-title" class="text-base font-semibold text-gray-900 dark:text-white">Lokasi &amp; PIC</h3>
        <button type="button" class="accordion-toggle md:hidden mt-3 w-full flex items-center justify-between gap-2 rounded-lg border border-slate-600 bg-slate-800 px-4 py-2.5 text-sm font-medium text-white hover:bg-slate-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500" aria-expanded="false" aria-controls="lokasi-panel" data-accordion-name="Lokasi &amp; PIC">
          <span data-accordion-label>Tampilkan Lokasi &amp; PIC</span>
          <svg class="w-4 h-4 shrink-0 transition-transform duration-200 motion-reduce:transition-none" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"></path>
          </svg>
        </button>
        <!-- Collapsed on mobile until the toggle is pressed; always shown from md up -->
        <div id="lokasi-panel" class="hidden md:block mt-4">
          <div data-locations class="grid grid-cols-[repeat(auto-fill,minmax(15rem,1fr))] gap-3"></div>
        </div>
      </section>

    </div>
  </div>
</Layout>

<style>
  .th {
    @apply px-3 py-2 text-xs font-semibold uppercase tracking-wider text-gray-700 dark:text-gray-400;
  }
  td {
    @apply px-3 py-2 text-xs text-gray-900 dark:text-gray-200 border-b border-gray-100 dark:border-gray-700;
  }
  [tabindex='0']:focus-visible {
    @apply outline-none ring-2 ring-blue-500 ring-offset-2 ring-offset-white dark:ring-offset-gray-800;
  }
  /* Thin scrollbar for the shift timeline, in the dark slate palette */
  .shift-scroll {
    scrollbar-width: thin;
    scrollbar-color: rgb(71 85 105) transparent;
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-pulse {
      animation: none;
    }
  }
</style>

<script>
  import { SHIFT_NAME, jakartaNow, resolveDuty } from '../lib/shift';

  // Shift code colours. White text on each fill meets 4.5:1; the letter is always shown too.
  const SHIFT_CLASS: Record<string, string> = {
    P: 'bg-sky-700 text-white',
    S: 'bg-indigo-600 text-white',
    M: 'bg-purple-700 text-white',
    O: 'bg-gray-600 text-white',
  };
  const SHIFT_ORDER = ['P', 'S', 'M'];

  type Member = { role: string; name: string; phone: string };
  type ItocPayload = {
    summary: {
      tim: { no: string; deskripsi: string; unit: string; pic: string }[];
      roster: { team: string; members: Member[] }[];
      lokasi: { no: string; lokasi: string; pic: string }[];
    };
    jadwal: {
      dates: string[];
      teams: { team: string; codes: string[] }[];
      legend: { code: string; label: string }[];
    };
  };

  const root = document.querySelector<HTMLElement>('[data-itoc-page]')!;
  const stateEl = (name: string) => root.querySelector<HTMLElement>(`[data-state="${name}"]`)!;
  const $ = <T extends HTMLElement = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;

  const showState = (name: 'loading' | 'error' | 'content') => {
    for (const s of ['loading', 'error', 'content']) {
      stateEl(s).classList.toggle('hidden', s !== name);
    }
  };

  const el = (tag: string, className = '', text?: string) => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  };

  const emptyRow = (cols: number, text = 'Tidak ada data tersedia') => {
    const tr = el('tr');
    const td = el('td', 'py-6 text-center text-sm text-gray-700 dark:text-gray-400', text);
    td.colSpan = cols;
    tr.appendChild(td);
    return tr;
  };

  const cell = (text: string) => {
    const td = el('td', '', text || '-');
    return td;
  };

  // Dates arrive as YYYY-MM-DD. Parse them as local dates so the day does not shift.
  const parseIsoDate = (iso: string) => {
    const [y, m, d] = iso.split('-').map(Number);
    return new Date(y, m - 1, d);
  };
  const todayIso = () => new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Jakarta', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
  const shortDay = new Intl.DateTimeFormat('id-ID', { day: '2-digit', month: 'short' });
  const weekday = new Intl.DateTimeFormat('id-ID', { weekday: 'short' });
  const longDate = new Intl.DateTimeFormat('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });

  const pill = (code: string) => {
    const span = el('span', `inline-flex items-center justify-center w-7 h-7 rounded font-semibold ${SHIFT_CLASS[code] ?? 'bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-gray-200'}`, code || '-');
    return span;
  };

  // "Analyst NOC" etc. Strip the "ITOC " prefix from the Unit column for display
  const roleLabel = (role: string) => role.replace(/^ITOC\s+/i, '');

  const memberRow = (m: Member) => {
    const li = el('li', 'py-2');
    li.appendChild(el('p', 'text-[11px] uppercase tracking-wider text-gray-700 dark:text-gray-400', roleLabel(m.role) || '-'));
    li.appendChild(el('p', 'text-sm font-medium text-gray-900 dark:text-white', m.name || '-'));
    if (m.phone) li.appendChild(el('p', 'text-xs text-gray-700 dark:text-gray-400 tabular-nums', m.phone));
    return li;
  };

  // Live clock in Jakarta time, HH:mm:ss WIB
  const clockFmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Jakarta', hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23' });
  const tickClock = () => {
    $('[data-clock]').textContent = `${clockFmt.format(new Date())} WIB`;
  };

  // Glow colour of the hero card, one per shift
  const HERO_CLASS: Record<string, string> = {
    P: 'border-sky-600 shadow-[0_0_36px_-8px_rgba(2,132,199,0.75)]',
    S: 'border-indigo-500 shadow-[0_0_36px_-8px_rgba(79,70,229,0.75)]',
    M: 'border-purple-600 shadow-[0_0_36px_-8px_rgba(147,51,234,0.75)]',
  };

  // Only the team on shift right now is shown, as one hero card
  const renderDuty = (p: ItocPayload) => {
    const container = $('[data-duty]');
    const now = jakartaNow();
    $('[data-today-date]').textContent = longDate.format(parseIsoDate(now.iso));
    container.replaceChildren();

    const duty = resolveDuty(p.jadwal, now);
    const code = duty.code;

    if (duty.status !== 'on-duty' || !duty.team) {
      container.appendChild(el('p', 'text-sm text-center text-gray-700 dark:text-gray-400',
        duty.status === 'no-schedule' ? 'Jadwal untuk waktu ini belum tersedia.' : 'Tidak ada tim yang bertugas saat ini.'));
      return;
    }
    const teamName = duty.team;

    const rosterTeam = p.summary.roster.find(r => r.team.trim().toLowerCase() === teamName.trim().toLowerCase());
    const timeLabel = p.jadwal.legend.find(l => l.code === code)?.label ?? '';

    const card = el('article', `w-full max-w-3xl rounded-2xl border-2 bg-gray-50 dark:bg-gray-900 p-6 sm:p-8 ${HERO_CLASS[code] ?? ''}`);
    card.setAttribute('aria-label', `Sedang bertugas: shift ${SHIFT_NAME[code]}, ${teamName}`);

    const head = el('div', 'flex items-start justify-between gap-4');
    const title = el('div');
    title.appendChild(el('p', 'text-xs font-semibold uppercase tracking-widest text-gray-700 dark:text-gray-400', 'Sedang bertugas'));
    title.appendChild(el('p', 'mt-1 text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white', `Shift ${SHIFT_NAME[code]} · ${teamName}`));
    if (timeLabel) title.appendChild(el('p', 'mt-1 text-sm text-gray-700 dark:text-gray-400', timeLabel));
    const big = pill(code);
    big.classList.replace('w-7', 'w-12');
    big.classList.replace('h-7', 'h-12');
    big.classList.add('text-lg');
    head.append(title, big);
    card.appendChild(head);

    const list = el('ul', 'mt-6 grid grid-cols-1 sm:grid-cols-2 gap-x-8 border-t border-gray-200 dark:border-gray-700');
    (rosterTeam?.members ?? []).forEach(m => list.appendChild(memberRow(m)));
    if (!rosterTeam) list.appendChild(el('li', 'py-3 text-sm text-gray-700 dark:text-gray-400', 'Daftar personel belum tersedia'));
    card.appendChild(list);

    container.appendChild(card);
  };

  const renderRoster = (p: ItocPayload) => {
    const container = $('[data-roster]');
    container.replaceChildren();
    const idx = p.jadwal.dates.indexOf(todayIso());

    if (p.summary.roster.length === 0) {
      container.appendChild(el('p', 'text-sm text-gray-700 dark:text-gray-400', 'Tidak ada data tersedia'));
      return;
    }

    for (const team of p.summary.roster) {
      const scheduled = p.jadwal.teams.find(t => t.team.trim().toLowerCase() === team.team.trim().toLowerCase());
      const code = idx === -1 || !scheduled ? '' : scheduled.codes[idx];

      const col = el('div', 'rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/60 p-4');
      const head = el('div', 'flex items-center justify-between gap-2');
      head.appendChild(el('p', 'text-sm font-semibold text-gray-900 dark:text-white', team.team));
      const status = code === 'O' ? 'Off' : (SHIFT_NAME[code] ?? '-');
      head.appendChild(el('span', 'text-xs text-gray-700 dark:text-gray-400', status));
      col.appendChild(head);

      const list = el('ul', 'mt-2 divide-y divide-gray-200 dark:divide-gray-700');
      team.members.forEach(m => list.appendChild(memberRow(m)));
      col.appendChild(list);
      container.appendChild(col);
    }
  };

  // "Zulfadly (081266624285) / Zulfadhli (089603437055)" -> one entry per PIC
  const parsePics = (pic: string) =>
    pic
      .split('/')
      .map(part => part.trim())
      .filter(part => part !== '')
      .map(part => {
        const match = /^(.*?)\s*\(([^)]*)\)\s*$/.exec(part);
        return match ? { name: match[1].trim(), phone: match[2].replace(/\s+/g, '') } : { name: part, phone: '' };
      });

  const renderLocations = (rows: ItocPayload['summary']['lokasi']) => {
    const grid = $('[data-locations]');
    grid.replaceChildren();
    if (rows.length === 0) {
      grid.appendChild(el('p', 'text-sm text-gray-700 dark:text-gray-400', 'Tidak ada data tersedia'));
      return;
    }
    for (const r of rows) {
      const card = el('article', 'rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/60 p-4 transition-colors hover:border-blue-500 dark:hover:border-blue-400');
      const top = el('div', 'flex items-start justify-between gap-2');
      top.appendChild(el('h4', 'text-base font-bold text-gray-900 dark:text-white', r.lokasi));
      top.appendChild(el('span', 'text-xs text-gray-700 dark:text-gray-400 tabular-nums', r.no));
      card.appendChild(top);

      const pics = el('ul', 'mt-3 flex flex-wrap gap-2');
      const entries = parsePics(r.pic);
      if (entries.length === 0) {
        pics.appendChild(el('li', 'text-xs text-gray-700 dark:text-gray-400', 'PIC belum ditentukan'));
      }
      for (const entry of entries) {
        const label = entry.phone ? `${entry.name} · ${entry.phone}` : entry.name;
        pics.appendChild(el('li', 'rounded-full border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 px-2.5 py-1 text-xs text-gray-900 dark:text-gray-200', label));
      }
      card.appendChild(pics);
      grid.appendChild(card);
    }
  };

  // Legend codes with their hours, shown at the top right of the timeline
  const SHIFT_HOURS: Record<string, string> = { P: '08:00-15:00', S: '15:00-22:00', M: '22:00-08:00' };
  const renderLegend = () => {
    const legend = $('[data-legend]');
    legend.replaceChildren();
    for (const code of ['P', 'S', 'M', 'O']) {
      const li = el('li', 'flex items-center gap-2');
      const swatch = el('span', `inline-flex items-center justify-center w-6 h-6 rounded text-xs font-bold ${SHIFT_CLASS[code]}`, code);
      const label = code === 'O' ? 'Off' : `${SHIFT_NAME[code]} (${SHIFT_HOURS[code]})`;
      li.append(swatch, el('span', '', label));
      legend.appendChild(li);
    }
  };

  // The timeline starts at today (Jakarta) and covers the next 30 days. Dates are YYYY-MM-DD, so string order is date order.
  const SHIFT_WINDOW_DAYS = 30;
  const addDaysIso = (iso: string, days: number) => {
    const d = new Date(`${iso}T00:00:00Z`);
    d.setUTCDate(d.getUTCDate() + days);
    return d.toISOString().slice(0, 10);
  };

  const renderShifts = (jadwal: ItocPayload['jadwal']) => {
    const head = $('[data-shift-head]');
    const body = $('[data-shift-body]');
    head.replaceChildren();
    body.replaceChildren();

    const today = todayIso();
    const last = addDaysIso(today, SHIFT_WINDOW_DAYS);
    const columns = jadwal.dates
      .map((iso, i) => ({ iso, i }))
      .filter(({ iso }) => iso >= today && iso <= last);

    if (columns.length === 0 || jadwal.teams.length === 0) {
      body.appendChild(emptyRow(1, 'Tidak ada jadwal untuk hari ini dan 30 hari ke depan'));
      return;
    }

    const headRow = el('tr');
    const corner = el('th', 'sticky left-0 top-0 z-20 bg-white dark:bg-gray-800 px-3 py-2 text-left font-semibold text-gray-900 dark:text-gray-200', 'Team');
    corner.scope = 'col';
    headRow.appendChild(corner);
    for (const { iso } of columns) {
      const d = parseIsoDate(iso);
      const th = el('th', `sticky top-0 z-10 bg-white dark:bg-gray-800 px-2 py-1 font-semibold whitespace-nowrap ${iso === today ? 'text-blue-700 dark:text-blue-300' : 'text-gray-900 dark:text-gray-200'}`);
      th.scope = 'col';
      th.title = longDate.format(d);
      th.textContent = shortDay.format(d);
      th.appendChild(el('div', 'font-normal text-gray-700 dark:text-gray-400', weekday.format(d)));
      headRow.appendChild(th);
    }
    head.appendChild(headRow);

    for (const team of jadwal.teams) {
      const tr = el('tr');
      const name = el('th', 'sticky left-0 z-10 bg-white dark:bg-gray-800 px-3 py-2 text-left font-semibold text-gray-900 dark:text-white whitespace-nowrap', team.team);
      name.scope = 'row';
      tr.appendChild(name);
      for (const { iso, i } of columns) {
        const code = team.codes[i] ?? '';
        const td = el('td', 'p-0.5');
        const span = pill(code);
        span.classList.add('w-7', 'h-7');
        span.title = `${team.team}, ${longDate.format(parseIsoDate(iso))}: ${code || '-'}`;
        td.appendChild(span);
        tr.appendChild(td);
      }
      body.appendChild(tr);
    }
  };

  const load = async () => {
    showState('loading');
    try {
      const res = await fetch('/api/itoc-summary', { headers: { Accept: 'application/json' } });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        const msg = typeof data.error === 'string' ? data.error : 'Gagal memuat data';
        $('[data-error-text]').textContent = msg;
        showState('error');
        return;
      }
      const payload = data as ItocPayload;
      renderDuty(payload);
      tickClock();
      // Clock ticks every second; the duty card re-checks the shift every minute
      window.setInterval(tickClock, 1000);
      // Re-check the clock every minute so the hero card and the timeline's start day follow the date
      window.setInterval(() => {
        renderDuty(payload);
        renderShifts(payload.jadwal);
      }, 60_000);
      renderRoster(payload);
      renderLocations(payload.summary.lokasi);
      renderLegend();
      renderShifts(payload.jadwal);
      showState('content');
    } catch {
      $('[data-error-text]').textContent = 'Gagal memuat data. Periksa koneksi lalu muat ulang halaman.';
      showState('error');
    }
  };

  // Mobile accordion for the roster and location panels. Desktop ignores these classes (md:block wins).
  root.querySelectorAll<HTMLButtonElement>('.accordion-toggle').forEach(btn => {
    const panel = document.getElementById(btn.getAttribute('aria-controls') ?? '');
    const label = btn.querySelector('[data-accordion-label]');
    const chevron = btn.querySelector('svg');
    const name = btn.dataset.accordionName ?? '';
    if (!panel || !label || !chevron) return;

    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      panel.classList.toggle('hidden', !open);
      chevron.classList.toggle('rotate-180', open);
      label.textContent = `${open ? 'Sembunyikan' : 'Tampilkan'} ${name}`;
    });
  });

  load();
</script>
