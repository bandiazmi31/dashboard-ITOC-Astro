---
interface Props {}
---

<div class="bg-white dark:bg-gray-800 rounded-lg shadow dark:shadow-gray-900 p-4">
  <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">Serah Terima (Handovers)</h3>

  <!-- Filter Status -->
  <div class="flex items-center space-x-2 mb-4">
    <label class="text-sm text-gray-600 dark:text-gray-300" for="status-filter">Status:</label>
    <select id="status-filter" class="border dark:border-gray-600 rounded px-2 py-1 text-sm bg-white dark:bg-gray-700 dark:text-white">
      <option value="open">Open</option>
      <option value="closed">Closed</option>
    </select>
    <button id="refresh-btn" class="ml-auto bg-blue-600 text-white px-2 py-1 rounded text-sm hover:bg-blue-700">Refresh</button>
  </div>

  <!-- Handovers List -->
  <div id="handovers-list" class="divide-y divide-gray-200 dark:divide-gray-700 mb-4">
    <div class="text-center py-4 text-gray-500 dark:text-gray-400">Loading...</div>
  </div>

  <!-- Add New Handover Form -->
  <div class="border-t border-gray-200 dark:border-gray-700 pt-4">
    <h4 class="font-medium text-gray-900 dark:text-white mb-2">Tambah Serah Terima Baru</h4>
    <div class="space-y-2">
      <input
        type="text"
        id="new-title"
        placeholder="Judul"
        class="w-full border dark:border-gray-600 rounded px-2 py-1 text-sm bg-white dark:bg-gray-700 dark:text-white"
      />
      <textarea
        id="new-desc"
        placeholder="Deskripsi (opsional)"
        class="w-full border dark:border-gray-600 rounded px-2 py-1 text-sm bg-white dark:bg-gray-700 dark:text-white"
        rows="2"
      />
      <input
        type="text"
        id="new-shift"
        placeholder="Info Shift"
        class="w-full border dark:border-gray-600 rounded px-2 py-1 text-sm bg-white dark:bg-gray-700 dark:text-white"
      />
      <button id="create-btn" class="bg-blue-600 text-white px-3 py-1 rounded text-sm hover:bg-blue-700">Buat</button>
    </div>
  </div>
</div>

<script>
  interface Handover {
    id: string | number;
    title: string;
    description?: string | null;
    shift_info?: string | null;
    status: 'open' | 'closed';
    created_at: string;
  }

  const statusFilter = document.getElementById('status-filter') as HTMLSelectElement;
  const refreshBtn = document.getElementById('refresh-btn') as HTMLButtonElement;
  const handoversList = document.getElementById('handovers-list') as HTMLDivElement;
  const newTitleInput = document.getElementById('new-title') as HTMLInputElement;
  const newDescInput = document.getElementById('new-desc') as HTMLTextAreaElement;
  const newShiftInput = document.getElementById('new-shift') as HTMLInputElement;
  const createBtn = document.getElementById('create-btn') as HTMLButtonElement;

  // All user-supplied values are written with textContent / dataset, never parsed as HTML.
  function renderMessage(text: string, colorClass: string): HTMLElement {
    const el = document.createElement('div');
    el.className = `text-center py-4 ${colorClass}`;
    el.textContent = text;
    return el;
  }

  function renderHandover(item: Handover): HTMLElement {
    const row = document.createElement('div');
    row.className = 'py-3 flex items-start justify-between';

    const body = document.createElement('div');
    body.className = 'flex-1';

    const title = document.createElement('h4');
    title.className = 'font-medium text-gray-900 dark:text-white';
    title.textContent = item.title;
    body.appendChild(title);

    if (item.description) {
      const desc = document.createElement('p');
      desc.className = 'text-xs text-gray-600 dark:text-gray-300';
      desc.textContent = item.description;
      body.appendChild(desc);
    }

    const meta = document.createElement('p');
    meta.className = 'text-xs text-gray-500 dark:text-gray-400';
    meta.textContent = `Shift: ${item.shift_info ?? ''} | Created: ${new Date(item.created_at).toLocaleDateString('id-ID')}`;
    body.appendChild(meta);

    row.appendChild(body);

    if (item.status === 'open') {
      const closeBtn = document.createElement('button');
      closeBtn.type = 'button';
      closeBtn.className = 'close-handover-btn bg-green-600 text-white px-2 py-1 rounded text-xs hover:bg-green-700 ml-2 whitespace-nowrap';
      closeBtn.dataset.id = String(item.id);
      closeBtn.textContent = 'Close';
      row.appendChild(closeBtn);
    }

    return row;
  }

  async function fetchHandovers() {
    try {
      const res = await fetch(`/api/handovers?status=${encodeURIComponent(statusFilter.value)}`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      const data: Handover[] = await res.json();

      if (!Array.isArray(data) || data.length === 0) {
        handoversList.replaceChildren(renderMessage('Tidak ada serah terima', 'text-gray-500 dark:text-gray-400'));
        return;
      }

      handoversList.replaceChildren(...data.map(renderHandover));
    } catch (err) {
      handoversList.replaceChildren(renderMessage('Gagal memuat handovers', 'text-red-600'));
    }
  }

  // One delegated listener instead of re-binding after every render
  handoversList.addEventListener('click', async (e) => {
    const closeBtn = (e.target as HTMLElement).closest<HTMLButtonElement>('.close-handover-btn');
    if (!closeBtn) return;

    try {
      const res = await fetch('/api/handovers/close', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: closeBtn.dataset.id })
      });

      if (!res.ok) {
        alert(`Gagal menutup handover: ${await errorMessageFrom(res)}`);
        return;
      }
      fetchHandovers();
    } catch (err) {
      alert('Gagal menutup handover: tidak dapat terhubung ke server');
    }
  });

  // Pull the server's { error } message out of a failed response, falling back to the status code
  async function errorMessageFrom(res: Response): Promise<string> {
    const body = await res.json().catch(() => null);
    return body?.error ?? `HTTP ${res.status}`;
  }

  async function createHandover() {
    if (!newTitleInput.value.trim()) {
      alert('Judul tidak boleh kosong');
      return;
    }

    try {
      const res = await fetch('/api/handovers/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title: newTitleInput.value,
          description: newDescInput.value,
          shift_info: newShiftInput.value
        })
      });

      if (!res.ok) {
        alert(`Gagal membuat handover: ${await errorMessageFrom(res)}`);
        return;
      }

      newTitleInput.value = '';
      newDescInput.value = '';
      newShiftInput.value = '';
      statusFilter.value = 'open';
      fetchHandovers();
    } catch (err) {
      alert('Gagal membuat handover: tidak dapat terhubung ke server');
    }
  }

  statusFilter.addEventListener('change', fetchHandovers);
  refreshBtn.addEventListener('click', fetchHandovers);
  createBtn.addEventListener('click', createHandover);

  // Initial load
  fetchHandovers();
</script>
