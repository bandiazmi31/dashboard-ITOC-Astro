---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<button
  id="theme-toggle"
  class={`p-2 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-700 transition ${className}`}
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
>
  <!-- Sun icon (light mode) -->
  <svg
    id="sun-icon"
    class="w-5 h-5 text-yellow-500 dark:hidden"
    fill="currentColor"
    viewBox="0 0 20 20"
  >
    <path
      fill-rule="evenodd"
      d="M10 2a1 1 0 011 1v2a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.536l1.414 1.414a1 1 0 001.414-1.414l-1.414-1.414a1 1 0 00-1.414 1.414zm2.828-2.828a1 1 0 011.414-1.414l1.414 1.414a1 1 0 11-1.414 1.414l-1.414-1.414zm0-4.242a1 1 0 011.414 1.414L17.07 9.071a1 1 0 11-1.414-1.414l1.414-1.414zM9 4a1 1 0 100-2 1 1 0 000 2zm0 16a1 1 0 100-2 1 1 0 000 2zm8-11a1 1 0 110-2 1 1 0 010 2zM4 9a1 1 0 100-2 1 1 0 000 2z"
      clip-rule="evenodd"
    ></path>
  </svg>

  <!-- Moon icon (dark mode) -->
  <svg
    id="moon-icon"
    class="w-5 h-5 text-blue-400 hidden dark:block"
    fill="currentColor"
    viewBox="0 0 20 20"
  >
    <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
  </svg>
</button>

<script>
  // Initialize theme immediately and on DOM ready
  function initTheme() {
    const htmlElement = document.documentElement;
    const savedTheme = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

    if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
      htmlElement.classList.add('dark');
    } else {
      htmlElement.classList.remove('dark');
    }
  }

  // Run immediately
  initTheme();

  // Also run on DOMContentLoaded to be safe
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTheme);
  }

  // Setup toggle button
  function setupToggle() {
    const themeToggle = document.getElementById('theme-toggle');
    const htmlElement = document.documentElement;

    if (!themeToggle) return;

    themeToggle.addEventListener('click', (e) => {
      e.preventDefault();
      
      if (htmlElement.classList.contains('dark')) {
        htmlElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        htmlElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
    });
  }

  // Setup on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupToggle);
  } else {
    setupToggle();
  }
</script>

