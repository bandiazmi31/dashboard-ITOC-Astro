---
interface Props {
  defaultDate: string;
}

const { defaultDate } = Astro.props;
---

<div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700">
  <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Unggah Excel Laporan SOC (.xlsx)</h3>

  <div class="flex flex-col sm:flex-row gap-4 sm:items-center">
    <label class="text-sm text-gray-700 dark:text-gray-300 whitespace-nowrap" for="socImportDate" title="Dipakai untuk baris yang tidak memiliki tanggal di kolom K01">Tanggal (baris tanpa tanggal)</label>
    <input
      type="date"
      id="socImportDate"
      value={defaultDate}
      class="px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md text-sm dark:bg-gray-800 dark:text-white"
    />
  </div>

  <div class="flex items-center gap-4 mt-4">
    <input
      type="file"
      accept=".xlsx, .xls"
      id="socFile"
      class="block w-full text-sm text-gray-500 dark:text-gray-400
        file:mr-4 file:py-2 file:px-4
        file:rounded-md file:border-0
        file:text-sm file:font-semibold
        file:bg-blue-50 file:text-blue-700
        hover:file:bg-blue-100
        dark:file:bg-gray-700 dark:file:text-gray-300"
    />
    <button
      id="socUploadBtn"
      disabled
      class="px-4 py-2 bg-blue-600 text-white rounded-md text-sm font-medium hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2 transition-colors whitespace-nowrap"
    >
      <svg id="socSpinner" class="hidden animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      Unggah Data
    </button>
  </div>

  <div id="socToast" role="status" class="mt-4 hidden p-3 rounded-md text-sm font-medium transition-all duration-300"></div>
</div>

<script>
  const fileInput = document.getElementById('socFile') as HTMLInputElement;
  const dateInput = document.getElementById('socImportDate') as HTMLInputElement;
  const btn = document.getElementById('socUploadBtn') as HTMLButtonElement;
  const spinner = document.getElementById('socSpinner');
  const toast = document.getElementById('socToast');

  const showToast = (message: string, type: 'success' | 'error') => {
    if (!toast) return;
    toast.textContent = message;
    toast.className = `mt-4 p-3 rounded-md text-sm font-medium ${
      type === 'success'
        ? 'bg-green-50 text-green-700 border border-green-200 dark:bg-green-900/30 dark:text-green-400 dark:border-green-800'
        : 'bg-red-50 text-red-700 border border-red-200 dark:bg-red-900/30 dark:text-red-400 dark:border-red-800'
    }`;
    toast.classList.remove('hidden');
    setTimeout(() => toast.classList.add('hidden'), 6000);
  };

  if (fileInput && btn) {
    fileInput.addEventListener('change', () => {
      btn.disabled = !(fileInput.files && fileInput.files.length > 0);
    });

    btn.addEventListener('click', async () => {
      const file = fileInput.files?.[0];
      if (!file) return;
      if (!dateInput.value) {
        showToast('❌ Pilih tanggal data terlebih dahulu.', 'error');
        return;
      }

      btn.disabled = true;
      spinner?.classList.remove('hidden');

      try {
        const form = new FormData();
        form.append('file', file);
        form.append('import_date', dateInput.value);

        const res = await fetch('/api/soc/upload-soc', { method: 'POST', body: form });
        const json = await res.json().catch(() => ({}));

        if (!res.ok) {
          // Server messages are already safe: validation text, or a generic error for 500s
          showToast(`❌ Gagal: ${json.error || 'Terjadi kesalahan. Coba lagi.'}`, 'error');
          return;
        }

        showToast(`✅ Berhasil menyimpan ${json.saved} baris laporan SOC untuk ${json.import_dates.length} tanggal.`, 'success');
        fileInput.value = '';
        btn.disabled = true;
        // Reload so the dashboard shows the newly imported date
        setTimeout(() => window.location.reload(), 1200);
      } catch {
        showToast('❌ Gagal mengunggah file. Periksa koneksi lalu coba lagi.', 'error');
      } finally {
        btn.disabled = fileInput.files?.length ? false : true;
        spinner?.classList.add('hidden');
      }
    });
  }
</script>
