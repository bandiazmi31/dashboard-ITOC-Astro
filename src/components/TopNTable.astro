---
interface Props {
  title: string;
  columns: string[];
  data: Array<Record<string, any>>;
  barColumn?: string;
  limit?: number;
  colorMapping?: 'severity' | 'default';
  statusColumn?: string;
}

const {
  title,
  columns,
  data = [],
  barColumn,
  limit = 10,
  colorMapping = 'default',
  statusColumn
} = Astro.props;

const limitedData = data.slice(0, limit);

const getBarColor = (colorKey?: string) => {
  if (colorMapping === 'severity') {
    switch (colorKey?.toLowerCase()) {
      case 'critical': return 'bg-red-500';
      case 'high': return 'bg-orange-500';
      case 'medium': return 'bg-yellow-500';
      case 'low': return 'bg-blue-400';
      default: return 'bg-blue-600';
    }
  }
  return 'bg-blue-650 bg-blue-600';
};

const getStatusBadge = (val: string) => {
  const lower = val?.toLowerCase() || '';
  if (lower === 'kritis' || lower === 'sla') {
    return '<span class="px-2 py-0.5 rounded text-xs font-semibold bg-red-100 text-red-800">Kritis</span>';
  }
  if (lower === 'tinggi') {
    return '<span class="px-2 py-0.5 rounded text-xs font-semibold bg-yellow-100 text-yellow-800">Utilisasi Tinggi</span>';
  }
  return val;
};
---

<div class="bg-white dark:bg-gray-800 rounded-lg shadow dark:shadow-gray-900 p-3 sm:p-4 flex flex-col justify-between">
  <h3 class="text-sm sm:text-base font-semibold text-gray-900 dark:text-white mb-3">{title}</h3>
  
  {limitedData.length === 0 ? (
    <div class="py-8 text-center text-sm text-gray-500 dark:text-gray-400">
      Tidak ada data tersedia
    </div>
  ) : (
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900">
            {columns.map(col => (
              <th class="px-3 py-2 text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider">{col}</th>
            ))}
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
          {limitedData.map((row, index) => {
            const keys = Object.keys(row).filter(k => k !== 'color' && k !== 'severity');
            const barVal = barColumn ? Number(row[barColumn]) || 0 : 0;
            const severityColor = row.color || row.severity;

            return (
              <tr class={index % 2 === 0 ? 'bg-white dark:bg-gray-800' : 'bg-gray-50/50 dark:bg-gray-900/50'}>
                {keys.slice(0, columns.length - (barColumn ? 1 : 0)).map((key, i) => {
                  const val = row[key];
                  const isStatus = statusColumn && statusColumn === key;

                  return (
                    <td class="px-3 py-2 text-xs text-gray-800 dark:text-gray-300 whitespace-nowrap">
                      {isStatus ? (
                        <Fragment set:html={getStatusBadge(val)} />
                      ) : (
                        val
                      )}
                    </td>
                  );
                })}
                
                {barColumn && (
                  <td class="px-3 py-2 text-xs text-gray-800 dark:text-gray-300 whitespace-nowrap w-48">
                    <div class="flex items-center gap-2">
                      <div class="flex-1 bg-gray-200 dark:bg-gray-700 rounded-full h-2">
                        <div 
                          class={`h-2 rounded-full ${getBarColor(severityColor)}`} 
                          style={`width: ${Math.min(barVal, 100)}%`}
                        ></div>
                      </div>
                      <span class="text-xs font-medium text-gray-600 dark:text-gray-400 w-10 text-right">{barVal}%</span>
                    </div>
                  </td>
                )}
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}
</div>
