---
interface Props {
  label: string;
  value: string | number;
  unit?: string;
  status?: 'safe' | 'warning' | 'critical' | 'info';
  badgeText?: string;
}

const { label, value, unit = '', status = 'info', badgeText } = Astro.props;

const badgeClasses = {
  safe: 'bg-green-100 text-green-800',
  warning: 'bg-yellow-100 text-yellow-800',
  critical: 'bg-red-100 text-red-800',
  info: 'bg-gray-100 text-gray-800'
};

const borderClasses = {
  safe: 'border-green-500',
  warning: 'border-yellow-500',
  critical: 'border-red-500',
  info: 'border-gray-300 dark:border-gray-600'
};
---

<div class={`bento-tile flex flex-col gap-2 p-3 sm:p-4 border-l-4 ${borderClasses[status]}`}>
  <div class="flex items-start justify-between gap-2">
    <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 font-medium leading-snug">{label}</p>
    {badgeText && (
      <span class={`px-2 py-0.5 rounded text-xs font-semibold whitespace-nowrap ${badgeClasses[status]}`}>
        {badgeText}
      </span>
    )}
  </div>
  <p class="flex flex-wrap items-baseline gap-x-1.5 min-w-0">
    <span class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white break-all">{value}</span>
    {unit && <span class="text-xs sm:text-sm text-gray-500 dark:text-gray-400">{unit}</span>}
  </p>
</div>
