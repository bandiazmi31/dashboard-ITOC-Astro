---
interface Props {
  dateFrom?: string;
  dateTo?: string;
}

const { dateFrom, dateTo } = Astro.props;
---

<div class="bg-white dark:bg-gray-800 rounded-lg shadow dark:shadow-gray-900 p-4">
  <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">Tiket ManageEngine (Real-time)</h3>
  
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="bg-blue-50 dark:bg-blue-900/30 p-3 rounded-lg border border-blue-200 dark:border-blue-700">
      <p class="text-xs text-blue-600 dark:text-blue-300 font-medium">Tiket Masuk</p>
      <p id="incoming-count" class="text-2xl font-bold text-blue-900 dark:text-blue-100">--</p>
    </div>
    
    <div class="bg-green-50 dark:bg-green-900/30 p-3 rounded-lg border border-green-200 dark:border-green-700">
      <p class="text-xs text-green-600 dark:text-green-300 font-medium">Tiket Selesai</p>
      <p id="resolved-count" class="text-2xl font-bold text-green-900 dark:text-green-100">--</p>
    </div>
    
    <div class="bg-purple-50 dark:bg-purple-900/30 p-3 rounded-lg border border-purple-200 dark:border-purple-700">
      <p class="text-xs text-purple-600 dark:text-purple-300 font-medium">SLA Met</p>
      <p id="sla-percentage" class="text-2xl font-bold text-purple-900 dark:text-purple-100">--</p>
    </div>
  </div>

  <p id="data-status" class="text-xs text-gray-500 dark:text-gray-400 mt-3">Loading data...</p>
</div>

<script define:vars={{ dateFrom, dateTo }}>
  async function loadTicketsData() {
    try {
      const params = new URLSearchParams();
      if (dateFrom) params.append('from', dateFrom);
      if (dateTo) params.append('to', dateTo);

      const res = await fetch(`/api/tickets/summary?${params.toString()}`);
      const data = await res.json();

      document.getElementById('incoming-count').textContent = data.incoming || 0;
      document.getElementById('resolved-count').textContent = data.resolved || 0;
      document.getElementById('sla-percentage').textContent = `${data.slaMetPercentage || 0}%`;
      document.getElementById('data-status').textContent = 
        data.status === 'live' 
          ? 'Data dari ManageEngine API (Real-time)' 
          : 'Data fallback (API tidak tersedia)';
    } catch (err) {
      console.error('Failed to load tickets:', err);
      document.getElementById('data-status').textContent = 'Gagal memuat data';
    }
  }

  // Load on page load
  loadTicketsData();

  // Refresh every 5 minutes
  setInterval(loadTicketsData, 300000);
</script>
