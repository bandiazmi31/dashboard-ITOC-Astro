---
interface Props {
  message?: string;
}

const { message = 'Gagal memuat data' } = Astro.props;
---

<div role="alert" class="bg-red-50 dark:bg-red-900/30 border-l-4 border-red-500 p-4 rounded">
  <p class="text-sm font-semibold text-red-800 dark:text-red-200">{message}</p>
  <p class="text-xs text-red-700 dark:text-red-300 mt-1">
    Data tidak dapat diambil dari database. Muat ulang halaman, atau hubungi tim NOC jika masalah berlanjut.
  </p>
</div>
