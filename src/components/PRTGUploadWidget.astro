---
interface Props {
  from?: string;
  to?: string;
}

const { from, to } = Astro.props;
---

<div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700">
  <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Unggah JSON PRTG (Hasil Power Query)</h3>
  
  <div class="flex items-center gap-4">
    <input 
      type="file" 
      accept=".json" 
      id="prtgFile"
      class="block w-full text-sm text-gray-500 dark:text-gray-400
        file:mr-4 file:py-2 file:px-4
        file:rounded-md file:border-0
        file:text-sm file:font-semibold
        file:bg-blue-50 file:text-blue-700
        hover:file:bg-blue-100
        dark:file:bg-gray-700 dark:file:text-gray-300"
    />
    <button 
      id="prtgUploadBtn" 
      disabled
      class="px-4 py-2 bg-blue-600 text-white rounded-md text-sm font-medium hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2 transition-colors whitespace-nowrap"
    >
      <svg id="prtgSpinner" class="hidden animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      Unggah Data
    </button>
  </div>
  
  <div id="toastContainer" class="mt-4 hidden p-3 rounded-md text-sm font-medium transition-all duration-300"></div>
</div>

<script>
  const fileInput = document.getElementById('prtgFile') as HTMLInputElement;
  const btn = document.getElementById('prtgUploadBtn') as HTMLButtonElement;
  const spinner = document.getElementById('prtgSpinner');
  const toastContainer = document.getElementById('toastContainer');

  const showToast = (message: string, type: 'success' | 'error') => {
    if (!toastContainer) return;
    toastContainer.textContent = message;
    toastContainer.className = `mt-4 p-3 rounded-md text-sm font-medium ${
      type === 'success' 
        ? 'bg-green-50 text-green-700 border border-green-200 dark:bg-green-900/30 dark:text-green-400 dark:border-green-800' 
        : 'bg-red-50 text-red-700 border border-red-200 dark:bg-red-900/30 dark:text-red-400 dark:border-red-800'
    }`;
    toastContainer.classList.remove('hidden');
    setTimeout(() => toastContainer.classList.add('hidden'), 6000);
  };

  if (fileInput && btn) {
    fileInput.addEventListener('change', () => {
      btn.disabled = !(fileInput.files && fileInput.files.length > 0);
    });

    btn.addEventListener('click', async () => {
      const file = fileInput.files?.[0];
      if (!file) return;

      btn.disabled = true;
      spinner?.classList.remove('hidden');

      try {
        const text = await file.text();
        // Sanitize control characters that break JSON.parse
        // Remove all control characters except tab, newline, carriage return
        const sanitized = text.replace(/[\x00-\x08\x0B\x0C\x0E-\x1F]/g, ' ');
        const data = JSON.parse(sanitized);

        const resp = await fetch('/api/noc/upload-prtg', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (resp.ok) {
          const json = await resp.json();
          showToast(`✅ Berhasil mengunggah ${json.inserted} baris data PRTG.`, 'success');
          fileInput.value = '';
        } else {
          const errJson = await resp.json().catch(() => ({}));
          showToast(`❌ Gagal: ${errJson.error || resp.statusText}`, 'error');
        }
      } catch (e: any) {
        showToast(`❌ Gagal memproses file JSON: ${e.message}`, 'error');
      } finally {
        btn.disabled = false;
        spinner?.classList.add('hidden');
      }
    });
  }
</script>
