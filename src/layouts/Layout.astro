---
// import type { AstroComponentFactory } from 'astro';
import DutyBadge from '../components/DutyBadge.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { getItocShiftSchedule } from '../lib/itoc-schedule';
import { createSupabaseServerClient } from '../lib/supabase';
import { getDisplayName } from '../lib/user';
import '../styles/global.css';

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Ringkasan' },
  { href: '/soc', label: 'SOC' },
  { href: '/noc', label: 'NOC' },
  { href: '/summary-jadwal', label: 'Summary & Jadwal' },
  { href: '/kelengkapan-data', label: 'Kelengkapan Data' },
  { href: '/admin', label: 'Admin' },
];

const supabase = createSupabaseServerClient(Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();
const displayName = getDisplayName(user);
const dutySchedule = user ? await getItocShiftSchedule() : null;
---

<html lang="id" class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ITOC Dashboard</title>
    <!-- Apply the saved theme before the first paint, so a page load in dark mode does not flash light -->
    <script is:inline>
      try {
        var saved = localStorage.getItem('theme');
        var dark = saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      } catch (e) {}
    </script>
  </head>
  <body class="flex flex-col min-h-screen bg-slate-200 dark:bg-gray-900 text-gray-900 dark:text-white">
    <!-- Header: brand + hamburger on mobile, one row on desktop -->
    <header class="bg-slate-100 dark:bg-gray-800 shadow-md border-b border-slate-300 dark:border-gray-700 lg:flex lg:items-center lg:gap-6 lg:px-4 lg:py-3">
      <!-- Top bar, always visible -->
      <div class="flex items-center justify-between p-3 sm:p-4 lg:p-0 lg:flex-shrink-0">
        <a href="/" class="flex items-center shrink-0" aria-label="Dashboard ITOC, ke beranda">
          <img src="/logo-itoc.png" alt="Dashboard ITOC" width="552" height="292" class="h-8 sm:h-9 w-auto object-contain" />
        </a>
        <button
          id="menu-toggle"
          type="button"
          class="lg:hidden p-2 rounded-lg text-gray-700 dark:text-gray-200 hover:bg-gray-200 dark:hover:bg-gray-700 transition-transform duration-300 motion-reduce:transition-none"
          aria-label="Buka menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <!-- Burger icon (menu closed) -->
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- Close icon (menu open) -->
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </div>

      <!-- Collapsible menu: animates open/closed below the top bar on mobile; always open on desktop -->
      <div
        id="mobile-menu"
        class="overflow-hidden transition-all duration-300 ease-in-out motion-reduce:transition-none max-h-0 opacity-0 lg:flex lg:flex-1 lg:max-h-none lg:opacity-100 lg:overflow-visible"
      >
        <div class="flex flex-col gap-3 px-3 pb-3 sm:px-4 border-t border-gray-200 dark:border-gray-700 bg-slate-200 dark:bg-gray-900 lg:flex-1 lg:flex-row lg:items-center lg:justify-between lg:gap-4 lg:p-0 lg:border-t-0 lg:bg-transparent lg:dark:bg-transparent">
          <nav aria-label="Menu utama">
            <ul class="flex flex-col lg:flex-row lg:flex-wrap gap-1 lg:gap-6 pt-3 lg:pt-0 text-sm">
              {navLinks.map(({ href, label }) => (
                <li>
                  <a
                    href={href}
                    class={currentPath === href
                      ? 'whitespace-nowrap block text-blue-600 dark:text-blue-400 font-semibold border-b-2 border-blue-600 dark:border-blue-400 pb-1'
                      : 'whitespace-nowrap block text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400'}
                  >
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          <div class="flex flex-col lg:flex-row lg:items-center gap-3 lg:gap-4 text-sm">
            <DutyBadge schedule={dutySchedule} />
            {displayName && <span class="truncate" title={user?.email ?? undefined}>{displayName}</span>}
            <div class="flex items-center gap-3">
              <ThemeToggle />
              <a href="/logout" class="text-blue-600 dark:text-blue-400 hover:underline whitespace-nowrap">Keluar</a>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Filter Bar -->
    <!-- <section class="bg-gray-100 dark:bg-gray-800 p-2 sm:p-3 flex flex-wrap gap-2 items-center text-xs sm:text-sm border-b border-gray-200 dark:border-gray-700">
      <label class="font-medium text-gray-700 dark:text-gray-300">Dari:</label>
      <input type="date" class="border dark:border-gray-600 rounded px-2 py-1 text-xs bg-white dark:bg-gray-700 dark:text-white" />
      <label class="font-medium text-gray-700 dark:text-gray-300">Sampai:</label>
      <input type="date" class="border dark:border-gray-600 rounded px-2 py-1 text-xs bg-white dark:bg-gray-700 dark:text-white" />
      <select class="border dark:border-gray-600 rounded px-2 py-1 text-xs bg-white dark:bg-gray-700 dark:text-white">
        <option>Semua data</option>
        <option>7 hari terakhir</option>
        <option>30 hari terakhir</option>
      </select>
      <button class="bg-primary text-white px-2 sm:px-3 py-1 rounded text-xs font-medium hover:bg-blue-700 dark:bg-blue-600 dark:hover:bg-blue-500">Terapkan</button>
      <button class="bg-gray-300 dark:bg-gray-600 text-gray-800 dark:text-gray-200 px-2 sm:px-3 py-1 rounded text-xs font-medium hover:bg-gray-400 dark:hover:bg-gray-500">Reset</button>
    </section> -->

    <!-- Main Content -->
    <main class="flex-1 p-3 sm:p-6">
      <slot />
    </main>

    <!-- Footer (optional) -->
    <footer class="bg-slate-100 dark:bg-gray-800 text-center py-2 text-xs text-gray-500 dark:text-gray-400 border-t border-slate-300 dark:border-gray-700">
      © 2026 PT Pelindo Multi Terminal
    </footer>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('menu-icon-open');
      const iconClose = document.getElementById('menu-icon-close');

      // Height and opacity are animated by CSS transitions; lg: overrides keep the desktop menu always visible
      const OPEN_CLASSES = ['max-h-[600px]', 'opacity-100'];
      const CLOSED_CLASSES = ['max-h-0', 'opacity-0'];

      // Closed mobile menu is clipped but still focusable, so mark it inert: keyboard focus and screen readers skip it.
      // Desktop never inerts the menu, since it is always visible there.
      const desktop = window.matchMedia('(min-width: 1024px)');
      const syncInert = () => {
        if (!menu) return;
        menu.inert = !desktop.matches && menu.classList.contains('max-h-0');
      };

      toggle?.addEventListener('click', () => {
        if (!menu) return;
        // Closed is the state with max-h-0, so a click on a closed menu opens it
        const opening = menu.classList.contains('max-h-0');
        menu.classList.remove(...(opening ? CLOSED_CLASSES : OPEN_CLASSES));
        menu.classList.add(...(opening ? OPEN_CLASSES : CLOSED_CLASSES));
        syncInert();

        toggle.setAttribute('aria-expanded', String(opening));
        toggle.setAttribute('aria-label', opening ? 'Tutup menu' : 'Buka menu');
        toggle.classList.toggle('rotate-90', opening);
        iconOpen?.classList.toggle('hidden', opening);
        iconClose?.classList.toggle('hidden', !opening);
      });

      // Re-check when the window crosses the md breakpoint (e.g. rotating a tablet or resizing a window)
      desktop.addEventListener('change', syncInert);
      syncInert();
    </script>
  </body>
</html>
