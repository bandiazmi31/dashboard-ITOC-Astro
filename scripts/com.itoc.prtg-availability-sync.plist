<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.itoc.prtg-availability-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/ben/vibeCode/dashboard-ITOC-Astro/scripts/prtg-availability-sync.sh</string>
  </array>
  <!-- Every day at 23:55 WIB (the machine's local time zone), so today's PRTG downtime is complete -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>23</integer>
    <key>Minute</key>
    <integer>55</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/ben/Library/Logs/itoc-prtg-availability-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ben/Library/Logs/itoc-prtg-availability-sync.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
