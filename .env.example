PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

MANAGEENGINE_API_KEY=your-manageengine-api-key
MANAGEENGINE_BASE_URL=https://your-instance.manageengine.com/api/v3

N8N_WEBHOOK_URL=http://localhost:5678/webhook/your-webhook-id

# PRTG Core API (NOC sync). The passhash is in PRTG under the user's settings; keep it out of git.
PRTG_BASE_URL=https://your-prtg-host
PRTG_USERNAME=your-prtg-username
PRTG_PASSHASH=your-prtg-passhash
# Set true only if PRTG uses a self-signed certificate (internal host)
PRTG_TLS_INSECURE=false

# Local ITOC summary workbook (Summary and Shift ITOC sheets)
ITOC_SUMMARY_XLSX_PATH=
